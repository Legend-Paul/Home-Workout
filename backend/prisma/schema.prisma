generator client {
  provider = "prisma-client-js"
  // output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String      @id @default(uuid())
  email          String      @unique
  username       String
  password       String
  goal           Goal?
  level          Level?
  role           Role        @default(USER)
  isBoarded      Boolean     @default(false)
  isVerified     Boolean     @default(false)
  onboardingStep Int         @default(0)
  setupMethod    SetupMethod @default(QUICK_START)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  verificationToken  VerificationToken[]
  passwordResetToken PasswordResetToken[]
  calendarEntries    CalendarEntry[]
  exercisesCreated   Exercise[]
  userPlans          UserPlan[]
  quickStartPlans    QuickStartPlan[]
  quickPlanUsers     QuickPlanUser[]
  friendsInitiated   Friendship[]         @relation("FriendshipInitiator")
  friendsReceived    Friendship[]         @relation("FriendshipReceiver")
}

model VerificationToken {
  id        String   @id @default(uuid())
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Exercise {
  id          String   @id @default(uuid())
  name        String // "Bicep Curls", "Push-ups"
  description String
  imageUrl    String
  videoUrl    String?
  level       Level    @default(ALL)
  muscleGroup String[]
  equipment   String[] @default([])
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   String?

  createdByUser       User?                @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  quickStartExercises QuickStartExercise[]
  weeklyPlanExercises WeeklyPlanExercise[]

  @@unique([name, createdBy])
}

model QuickStartPlan {
  id        String  @id @default(uuid())
  name      String  @unique
  goal      Goal
  level     Level
  isActive  Boolean @default(true)
  createdBy String?

  createdByUser User? @relation(fields: [createdBy], references: [id], onDelete: SetNull)

  quickStartWeeklyPlan QuickStartWeeklyPlan[]
  quickPlanUsers       QuickPlanUser[]
}

model QuickStartWeeklyPlan {
  id               String   @id @default(uuid())
  quickStartPlanId String
  name             String
  dayOfWeek        Int // 0-6 (Sunday-Saturday)
  muscleGroup      String[] // e.g., ["Arms", "Legs"]
  isRestDay        Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  quickStartExercises QuickStartExercise[]
  quickStartPlan      QuickStartPlan       @relation(fields: [quickStartPlanId], references: [id], onDelete: Cascade)

  @@unique([quickStartPlanId, dayOfWeek])
}

model QuickStartExercise {
  id                     String   @id @default(uuid())
  quickStartWeeklyPlanId String
  exerciseId             String
  order                  Int // 1-10 (order in the plan)
  reps                   Int?
  sets                   Int?
  duration               Int? // in seconds
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  quickStartWeeklyPlan QuickStartWeeklyPlan @relation(fields: [quickStartWeeklyPlanId], references: [id], onDelete: Cascade)
  exercise             Exercise             @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@unique([quickStartWeeklyPlanId, exerciseId])
  @@index([quickStartWeeklyPlanId])
}

model QuickPlanUser {
  id               String   @id @default(uuid())
  userId           String
  quickStartPlanId String
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  quickStartPlan QuickStartPlan @relation(fields: [quickStartPlanId], references: [id], onDelete: Cascade)
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, quickStartPlanId])
}

model UserPlan {
  id        String   @id @default(uuid())
  name      String
  userId    String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  weeklyPlan WeeklyPlan[]
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@index([userId])
}

model WeeklyPlan {
  id          String   @id @default(uuid())
  userPlanId  String
  name        String
  dayOfWeek   Int // 0-6 (Sunday-Saturday)
  muscleGroup String[] // e.g., ["Arms", "Legs"]
  isRestDay   Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userPlan            UserPlan             @relation(fields: [userPlanId], references: [id], onDelete: Cascade)
  weeklyPlanExercises WeeklyPlanExercise[]
  calendarEntries     CalendarEntry[]

  @@unique([userPlanId, dayOfWeek])
}

model WeeklyPlanExercise {
  id           String   @id @default(uuid())
  weeklyPlanId String
  exerciseId   String
  order        Int // 1-10 (order in the plan)
  reps         Int?
  sets         Int?
  duration     Int? // in seconds
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  weeklyPlan WeeklyPlan @relation(fields: [weeklyPlanId], references: [id], onDelete: Cascade)
  exercise   Exercise   @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@unique([weeklyPlanId, exerciseId])
  @@index([weeklyPlanId])
}

// User's weekly schedule
model CalendarEntry {
  id           String   @id @default(uuid())
  date         DateTime
  startTime    DateTime
  endTime      DateTime
  timeUsed     Int? // in minutes
  status       Status   @default(PENDING)
  userId       String
  weeklyPlanId String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  weeklyPlan WeeklyPlan? @relation(fields: [weeklyPlanId], references: [id], onDelete: SetNull)

  @@index([userId, date])
}

model Friendship {
  id        String           @id @default(uuid())
  userId    String
  friendId  String
  status    FriendshipStatus @default(PENDING)
  createdAt DateTime         @default(now())

  user   User @relation("FriendshipInitiator", fields: [userId], references: [id], onDelete: Cascade)
  friend User @relation("FriendshipReceiver", fields: [friendId], references: [id], onDelete: Cascade)

  @@unique([userId, friendId])
  @@index([userId])
  @@index([friendId])
}

enum Role {
  USER
  ADMIN
  MASTER
}

enum Goal {
  BUILD_MUSCLE
  LOSE_FAT
  MAINTAIN_FITNESS
  ALL
}

enum Level {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  ALL
}

enum Status {
  PENDING
  COMPLETED
  SKIPPED
  REST
}

enum SetupMethod {
  QUICK_START
  CUSTOM
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
  BLOCKED
}

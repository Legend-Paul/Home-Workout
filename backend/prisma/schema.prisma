generator client {
  provider = "prisma-client-js"
  // output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  username  String
  password  String
  goal      Goal
  level     Level
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  calendarEntries      CalendarEntry[]
  userWorkoutExercises UserWorkoutExercise[]
}

// Main categories like "Arms", "Legs", "Chest", "Back"
model Category {
  id          String  @id @default(uuid())
  name        String  @unique // "Arms", "Legs", "Chest", "Back", "Core"
  description String
  imageUrl    String?
  order       Int // Display order

  workouts        Workout[]
  exercises       Exercise[]
  calendarEntries CalendarEntry[]
}

// Specific workouts like "Biceps", "Triceps", "Quadriceps"
model Workout {
  id          String  @id @default(uuid())
  title       String @unique// "Biceps Workout", "Triceps Workout"
  description String
  categoryId  String
  imageUrl    String?
  // level       Level
  // goal        Goal?

  category             Category              @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  workoutExercises     WorkoutExercise[]
  calendarEntries      CalendarEntry[]
  userWorkoutExercises UserWorkoutExercise[]

  @@index([categoryId, title])
}

model Exercise {
  id          String  @id @default(uuid())
  name        String  @unique // "Bicep Curls", "Push-ups"
  description String
  imageUrl    String
  videoUrl    String?
  difficulty  Level?
  categoryId  String

  categories             Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  userWorkoutExercises UserWorkoutExercise[]
  workoutExercises     WorkoutExercise[]

  @@index([categoryId, name])
}

model WorkoutExercise {
  id         String @id @default(uuid())
  workoutId  String
  exerciseId String
  order      Int // 1-5 (order in workout)

  workout  Workout  @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  exercise Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@unique([workoutId, exerciseId])
  @@index([workoutId])
}

// User's selected exercises for a specific workout (with their customization)
model UserWorkoutExercise {
  id         String @id @default(uuid())
  userId     String
  workoutId  String
  exerciseId String
  dayOfWeek  Int // 0-6 (Sunday-Saturday)
  sets       Int?
  reps       Int?
  duration   Int? // in seconds
  order      Int // 1-5 (order in user's routine)

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  workout  Workout  @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  exercise Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@unique([userId, workoutId, exerciseId])
  @@index([userId, workoutId])
}

// User's weekly schedule
model CalendarEntry {
  id         String   @id @default(uuid())
  date       DateTime
  dayOfWeek  Int // 0-6 (Sunday-Saturday)
  status     Status   @default(PENDING)
  userId     String
  workoutId  String? // null if rest day
  categoryId String? // null if rest day

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  workout  Workout?  @relation(fields: [workoutId], references: [id], onDelete: SetNull)

  @@unique([userId, date])
  @@index([userId, date])
}

enum Role {
  USER
  ADMIN
}

enum Goal {
  BUILD_MUSCLE
  LOSE_FAT
  MAINTAIN_FITNESS
  OTHER
}

enum Level {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum Status {
  PENDING
  COMPLETED
  SKIPPED
  REST
}

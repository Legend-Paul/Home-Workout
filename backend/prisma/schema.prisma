generator client {
  provider = "prisma-client-js"
  // output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String  @id @default(uuid())
  email          String  @unique
  username       String
  password       String
  goal           Goal?
  level          Level?
  role           Role    @default(USER)
  isBoarded      Boolean @default(false)
  onboardingStep Int     @default(0)

  setupMethod SetupMethod @default(QUICK_START)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  calendarEntries  CalendarEntry[]
  exercisesCreated Exercise[]
  weeklyPlans      WeeklyPlan[]
  friendsInitiated Friendship[]    @relation("FriendshipInitiator")
  friendsReceived  Friendship[]    @relation("FriendshipReceiver")
}

model Exercise {
  id           String   @id @default(uuid())
  name         String   @unique // "Bicep Curls", "Push-ups"
  description  String
  imageUrl     String
  videoUrl     String?
  level   Level    @default(ALL)
  muscleGroup  String[]
  equipment    String[] @default([])
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  createdBy    String?

  createdByUser       User?                @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  quickStartExercises QuickStartExercise[]
  weeklyPlanExercises WeeklyPlanExercise[]
}

model QuickStartPlan {
  id           String   @id @default(uuid())
  name         String   @unique
  goal         Goal
  level        Level
  dayOfWeek    Int // 0-6 (Sunday-Saturday)
  dayName      String // "Monday", "Tuesday", 
  muscleGroup  String[] // e.g., ["Arms", "Legs"]
  isRestDay    Boolean  @default(false)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  quickStartExercises QuickStartExercise[]
}

model QuickStartExercise {
  id               String @id @default(uuid())
  quickStartPlanId String
  exerciseId       String
  order            Int // 1-10 (order in the plan)
  reps             Int?
  sets             Int?
  duration         Int? // in seconds

  quickStartPlan QuickStartPlan @relation(fields: [quickStartPlanId], references: [id], onDelete: Cascade)
  exercise       Exercise       @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@unique([quickStartPlanId, exerciseId])
  @@index([quickStartPlanId])
}

model WeeklyPlan {
  id           String   @id @default(uuid())
  userId       String
  name         String 
  dayOfWeek    Int // 0-6 (Sunday-Saturday)
  dayName      String // "Monday", "Tuesday", 
  muscleGroup  String[] // e.g., ["Arms", "Legs"]
  isRestDay    Boolean  @default(false)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  weeklyPlanExercises WeeklyPlanExercise[]
  calendarEntries     CalendarEntry[]

  @@unique([userId, dayOfWeek])
  @@index([userId])
}

model WeeklyPlanExercise {
  id           String   @id @default(uuid())
  weeklyPlanId String
  exerciseId   String
  order        Int // 1-10 (order in the plan)
  reps         Int?
  sets         Int?
  duration     Int? // in seconds
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  weeklyPlan WeeklyPlan @relation(fields: [weeklyPlanId], references: [id], onDelete: Cascade)
  exercise   Exercise   @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@unique([weeklyPlanId, exerciseId])
  @@index([weeklyPlanId])
}

// User's weekly schedule
model CalendarEntry {
  id           String   @id @default(uuid())
  date         DateTime
  startTime    DateTime
  endTime      DateTime
  timeUsed     Int? // in minutes
  status       Status   @default(PENDING)
  userId       String
  weeklyPlanId String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  weeklyPlan WeeklyPlan? @relation(fields: [weeklyPlanId], references: [id], onDelete: SetNull)

  @@unique([userId, date])
  @@index([userId, date])
}

model Friendship {
  id        String           @id @default(uuid())
  userId    String
  friendId  String
  status    FriendshipStatus @default(PENDING)
  createdAt DateTime         @default(now())

  user   User @relation("FriendshipInitiator", fields: [userId], references: [id], onDelete: Cascade)
  friend User @relation("FriendshipReceiver", fields: [friendId], references: [id], onDelete: Cascade)

  @@unique([userId, friendId])
  @@index([userId])
  @@index([friendId])
}

enum Role {
  USER
  ADMIN
  MASTER
}

enum Goal {
  BUILD_MUSCLE
  LOSE_FAT
  MAINTAIN_FITNESS
  OTHER
}

enum Level {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  ALL
}

enum Status {
  PENDING
  COMPLETED
  SKIPPED
  REST
}

enum SetupMethod {
  QUICK_START
  CUSTOM
}

enum Days {
  SUNDAY
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
  BLOCKED
}
